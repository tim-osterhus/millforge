{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "types": [
      "node"
    ],
    "allowJs": true
  },
  "include": [
    "src/*.ts",
    "tests/*.test.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
