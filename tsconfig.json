{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "esModuleInterop": true, "skipLibCheck": true, "rootDir": ".", "outDir": "dist/node",
    "declaration": true, "sourceMap": false, "types": ["node"]
  },
  "include": ["src/*.ts", "tests/*.test.ts"],
  "exclude": ["node_modules", "dist", "src/millforge"]
}
